# Copia a backend/.env y completa los valores

# IA (opcional — sin key usa modo demo)
GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# Firebase (opcional — sin esto usa JSON local en /data)
FIREBASE_PROJECT_ID=kawsaqeco
FIREBASE_WEB_API_KEY=
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# En cloud (Render/Railway): pega el JSON en una sola línea
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Redis (opcional)
# REDIS_URL=redis://localhost:6379

# Auth JWT — obligatorio en producción
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRE_HOURS=168

# Entorno: development | production
APP_ENV=development

# Geofencing — metros máximos para confirmar entrega en acopio
ACOPIO_GEOFENCE_RADIUS_M=150

# Solo producción — orígenes permitidos separados por coma
# CORS_ORIGINS=https://kawsaqeco.app
