{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:usb": "powershell -ExecutionPolicy Bypass -File ./scripts/start-usb.ps1",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./scripts/start-all-usb.ps1",
    "start:emulator": "powershell -ExecutionPolicy Bypass -File ./scripts/start-emulator.ps1",
    "start:wifi": "powershell -ExecutionPolicy Bypass -File ./scripts/start-wifi.ps1",
    "android": "expo start --android --clear",
    "android:dev": "expo run:android",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "google:sha1": "powershell -ExecutionPolicy Bypass -File ./scripts/get-android-sha1.ps1",
    "google:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-google-signin.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.18.0",
    "@react-navigation/native": "^7.3.1",
    "axios": "^1.17.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
